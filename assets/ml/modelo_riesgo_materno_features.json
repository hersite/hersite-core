    "Embarazo_Multiple",
    "Antecedente_Hemorragia",
    "Presion_Basal_Disponible",
    "Presion_Basal_Sistolica",
    "Presion_Basal_Diastolica",
    "Presion_Actual_Disponible",
    "Presion_Sistolica",
    "Presion_Diastolica",
    "Taquicardia_Sostenida",
    "Cefalea_Intensa",
    "Alteracion_Visual",
    "Zumbido_Oidos",
    "Dolor_Hipocondrio_Derecho",
    "Dolor_Boca_Estomago",
